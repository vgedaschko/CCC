{
  "name": "ccc-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Design-agnostic HTML presentation engine for the CCC group talk (Big D or little d?), with PDF and PPTX export.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node tests/run-tests.cjs && node tests/big-d.cjs",
    "build": "node tools/build.cjs slides/demo.html dist/demo.html",
    "pdf": "node tools/export-pdf.cjs slides/demo.html dist/demo.pdf",
    "pptx": "node tools/export-pptx.cjs slides/demo.html dist/demo.pptx",
    "export": "npm run build && npm run pdf && npm run pptx",
    "assemble": "node tools/assemble.cjs",
    "check": "node tools/check-deck.cjs --deck slides/big-d.html",
    "deck:build": "node tools/build.cjs slides/big-d.html dist/big-d.html --strict",
    "deck:pdf": "node tools/export-pdf.cjs slides/big-d.html dist/big-d.pdf",
    "deck:pdf-paper": "node tools/export-pdf.cjs slides/big-d.html dist/big-d-paper.pdf --paper",
    "deck:pptx": "node tools/export-pptx.cjs slides/big-d.html dist/big-d.pptx --jpeg 94",
    "test:engine": "node tests/run-tests.cjs",
    "test:deck": "node tests/big-d.cjs",
    "check:stress": "node tools/check-deck.cjs --deck slides/big-d.html --stress",
    "deck:all": "node tools/assemble.cjs && npm run deck:build && npm run deck:pdf && npm run deck:pdf-paper && npm run deck:pptx"
  },
  "devDependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
